{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/session-wiring.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/depth-flag.sh" },
          { "type": "command", "command": "$HOME/.claude/hooks/field-refresh.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/git-commit-guard.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/hooks/reply-length-guard.sh" },
          { "type": "command", "command": "$HOME/.claude/hooks/reply-content-guard.sh" },
          { "type": "command", "command": "$HOME/.claude/hooks/additive-guard.sh" }
        ]
      }
    ]
  }
}
